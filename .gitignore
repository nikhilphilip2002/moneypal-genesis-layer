# Env / secrets
.env
.env.local
*.env
# `*.env` only catches names ending in .env (prod.env), not .env.prod — which is where
# real keys actually get written. Ignore every .env.<suffix>, then re-admit the template.
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/
.pytest_cache/

# Node / Next
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# RAG data (don't commit downloaded PDFs / model cache)
**/data/
module*/data/
*.pdf
!docs/*.pdf

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log
CLAUDE.md

Regulations/

# Archives / Zip
*.zip

# Generated brief cache + local fallback index
backend/vector_store/

# Generated benchmark / evaluation reports
# Keep the runner scripts in Git; ignore their local report output. Existing historical
# reports that are already tracked remain tracked until explicitly removed.
/benchmark_*_report*.md
/benchmark_*_queries*.md
/benchmark_random_*.md
/query_test_results_*.md
/test_*_results.md
/fix.md

# Rendered documentation previews (the authored source/checklists remain trackable)
/docs/*_architecture_diagram.html
/docs/*_architecture_diagram.jpg
