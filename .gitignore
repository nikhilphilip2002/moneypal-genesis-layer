# Env / secrets
.env
.env.local
*.env
# `*.env` only catches names ending in .env (prod.env), not .env.prod — which is where
# real keys actually get written. Ignore every .env.<suffix>, then re-admit the template.
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/
.pytest_cache/

# Node / Next
node_modules/
.next/
out/
dist/
*.tsbuildinfo

# RAG data (don't commit downloaded PDFs / model cache)
**/data/
module*/data/
*.pdf
!docs/*.pdf

# Editor / OS
.DS_Store
.idea/
.vscode/
*.log
CLAUDE.md

Regulations/

# Archives / Zip
*.zip

# Generated brief cache + local fallback index
backend/vector_store/
