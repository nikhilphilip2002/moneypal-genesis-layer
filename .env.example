# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Groq LLM
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant (shared instance — must be on Aroha_T1 / Aroha_G1 WiFi)
QDRANT_HOST=192.168.1.183
QDRANT_PORT=6333
QDRANT_TIMEOUT=10

# Embedding model
EMBED_MODEL=BAAI/bge-m3

# PostgreSQL Database Configuration for Curiosity Graph
POSTGRES_HOST=100.70.118.31
POSTGRES_PORT=5432
POSTGRES_DB=moneypaldb
POSTGRES_USER=moneypal
POSTGRES_PASSWORD=your_postgres_password_here
# The API uses the internal governed PostgreSQL MCP service. The MCP container overrides
# this to `direct` so it executes the validated read-only query without calling itself.
POSTGRES_ACCESS_MODE=mcp
POSTGRES_MCP_URL=http://postgres-mcp:8001/mcp

# --- Genesis NLQ (natural-language query layer) ---------------------------------------
# Provider: groq for development, llamacpp once the GPU node is procured. Deploy-time
# config swap only — no pipeline code changes.
#
# llama-server is hosted and operated outside this compose stack; point BASE_URL at it.
# It must stay on a private network — never internet-exposed — since a reachable endpoint
# is an unauthenticated LLM. Customer data never leaves the app node either way: the
# model receives questions and catalog metadata, never loan or customer rows.
NLQ_LLM_PROVIDER=groq
NLQ_LLM_BASE_URL=http://<gpu-private-ip>:8080/v1
NLQ_LLM_MODEL=qwen3.6-32b-instruct-q4_K_M
NLQ_LLM_API_KEY=
NLQ_LLM_TIMEOUT_S=30
NLQ_LLM_MAX_RETRIES=1
# Qwen3-class models think before answering, and llama-server returns that trace in
# `reasoning_content` with `content` empty — the planner then sees no plan at all and
# every question ends in a refusal. Leave this off; the planner fills in a form, it does
# not need to deliberate. Only turn it on to debug a model's routing decisions.
NLQ_LLM_THINKING=false
# Hybrid vectors improve obscure paraphrase matching on the SQL fallback. Set false in a
# cold/stateless service that does not have a persistent Hugging Face model cache.
NLQ_CATALOG_VECTORS=true

# Read-only database role — the NLQ security boundary. Create it with
# backend/scripts/sql/nlq_readonly_role.sql (superuser, once). Must be a DIFFERENT
# credential from POSTGRES_PASSWORD above; NLQ refuses to run as the app role.
NLQ_DB_USER=nlq_readonly
NLQ_DB_PASSWORD=

# PostgreSQL comparison path: `direct` uses the in-process adapter; `mcp` sends loan-book
# and schema tool calls through the internal Streamable HTTP MCP service.
POSTGRES_ACCESS_MODE=direct
POSTGRES_MCP_URL=http://postgres-mcp:8001/mcp
POSTGRES_MCP_TIMEOUT_S=30
NLQ_STATEMENT_TIMEOUT_MS=15000
NLQ_MAX_ROWS=5000
