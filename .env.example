# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Groq LLM
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant (shared instance — must be on Aroha_T1 / Aroha_G1 WiFi)
# QDRANT_URL is canonical and wins over HOST/PORT when set. Credentials are read from
# the environment only — never hardcode them in pipeline or service code.
QDRANT_URL=http://192.168.1.183:6333
QDRANT_HOST=192.168.1.183
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_TIMEOUT=10

# Embedding model
EMBED_MODEL=BAAI/bge-m3

# --- Macro intelligence ingestion pipeline --------------------------------------------
# Weekly crawl -> extract -> embed -> upsert into MACRO_COLLECTION, then purge every
# point not stamped with the current run id. Set MACRO_COLLECTION to a scratch name to
# rehearse the cycle without touching what the macro API serves.
MACRO_COLLECTION=macro_intel1
MACRO_SCHEDULE_DAY=sun
MACRO_SCHEDULE_HOUR=10
MACRO_SCHEDULE_MINUTE=0
MACRO_SCHEDULE_TZ=Asia/Kolkata
# A container restart should not kick off a full crawl.
MACRO_RUN_ON_STARTUP=false
# Purge safety rail: skip the sweep if this run stamped less than this fraction of the
# pre-run point count. Stops one blocked-crawl week from emptying the collection.
MACRO_PURGE_STALE=true
MACRO_PURGE_MIN_RATIO=0.5
# Points predating this pipeline (no ingest_run stamp) are left alone by the weekly
# purge. macro_intel1 holds thousands of them from an earlier ingest covering sources
# the crawler cannot reach — retire them deliberately via `run.py migrate`, not by
# flipping this on.
MACRO_PURGE_LEGACY=false
# Crawl politeness and bounds.
MACRO_RESPECT_ROBOTS=true
MACRO_REQUEST_DELAY_S=1.0
MACRO_REQUEST_TIMEOUT_S=45
MACRO_MAX_PAGES_PER_SITE=100
MACRO_MAX_DEPTH=2
MACRO_MAX_FILES_PER_SITE=50
MACRO_MAX_DOWNLOAD_MB=80
# Paths. The defaults below are correct for a source checkout; docker-compose overrides
# the first two with in-container paths backed by the macro-data volume.
# MACRO_DATA_DIR=backend/data/macro
# MACRO_STATE_FILE=backend/data/macro/state.json
# MACRO_SOURCES_FILE=backend/scripts/macro_pipeline/sources.txt

# PostgreSQL Database Configuration for Curiosity Graph
POSTGRES_HOST=100.70.118.31
POSTGRES_PORT=5432
POSTGRES_DB=moneypaldb
POSTGRES_USER=moneypal
POSTGRES_PASSWORD=your_postgres_password_here
# The API uses the internal governed PostgreSQL MCP service. The MCP container overrides
# this to `direct` so it executes the validated read-only query without calling itself.
POSTGRES_ACCESS_MODE=mcp
POSTGRES_MCP_URL=http://postgres-mcp:8001/mcp

# --- Genesis NLQ (natural-language query layer) ---------------------------------------
# Provider: groq for development, llamacpp once the GPU node is procured. Deploy-time
# config swap only — no pipeline code changes.
#
# llama-server is hosted and operated outside this compose stack; point BASE_URL at it.
# It must stay on a private network — never internet-exposed — since a reachable endpoint
# is an unauthenticated LLM. Customer data never leaves the app node either way: the
# model receives questions and catalog metadata, never loan or customer rows.
NLQ_LLM_PROVIDER=groq
NLQ_LLM_BASE_URL=http://<gpu-private-ip>:8080/v1
NLQ_LLM_MODEL=qwen3.6-32b-instruct-q4_K_M
NLQ_LLM_API_KEY=
NLQ_LLM_TIMEOUT_S=30
NLQ_LLM_MAX_RETRIES=1
# Total wall-clock budget for planning plus execution. It should not be shorter
# than the LLM client timeout when the model is hosted locally.
NLQ_REQUEST_BUDGET_S=60
# Qwen3-class models think before answering, and llama-server returns that trace in
# `reasoning_content` with `content` empty — the planner then sees no plan at all and
# every question ends in a refusal. Leave this off; the planner fills in a form, it does
# not need to deliberate. Only turn it on to debug a model's routing decisions.
NLQ_LLM_THINKING=false
# Hybrid vectors improve obscure paraphrase matching on the SQL fallback. Set false in a
# cold/stateless service that does not have a persistent Hugging Face model cache.
NLQ_CATALOG_VECTORS=true

# Read-only database role — the NLQ security boundary. Create it with
# backend/scripts/sql/nlq_readonly_role.sql (superuser, once). Must be a DIFFERENT
# credential from POSTGRES_PASSWORD above; NLQ refuses to run as the app role.
NLQ_DB_USER=nlq_readonly
NLQ_DB_PASSWORD=

# PostgreSQL comparison path: `direct` uses the in-process adapter; `mcp` sends loan-book
# and schema tool calls through the internal Streamable HTTP MCP service.
POSTGRES_ACCESS_MODE=direct
POSTGRES_MCP_URL=http://postgres-mcp:8001/mcp
# Must exceed NLQ_REQUEST_BUDGET_S because this transport wraps the complete NLQ turn.
POSTGRES_MCP_TIMEOUT_S=75
NLQ_STATEMENT_TIMEOUT_MS=15000
NLQ_MAX_ROWS=5000
# Temporary rollout switch. Set false when role-based PII permissions are implemented.
NLQ_OPEN_PII_ACCESS=true

# --- Workbench conversation compaction ------------------------------------------------
# Long conversations are checkpointed instead of truncated. Figures, sources and refusals
# are extracted mechanically from completed turns and always carried; the LLM summary is
# an extra layer on top and is off until proven.
WORKBENCH_CONTEXT_WINDOW=32768
WORKBENCH_RESERVE_TOKENS=8192
WORKBENCH_KEEP_RECENT_TURNS=6
WORKBENCH_COMPACTION_ENABLED=false
WORKBENCH_COMPACTION_MAX_TOKENS=1200
